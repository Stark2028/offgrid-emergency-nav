{
  "name": "@offgrid/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node tools/build-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "test:packs": "node tools/verify-packs.mjs",
    "android:sync": "cap sync android && node tools/prune-native-packs.mjs",
    "android:add": "cap add android",
    "test:android": "node tools/native-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/geolocation": "8.2.4",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@offgrid/core": "workspace:*",
    "@offgrid/maps": "workspace:*",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0"
  }
}
